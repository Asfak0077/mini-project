PORT=5001
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database
SECRET_KEY=replace_with_secure_secret
JWT_SECRET=replace_with_secure_secret
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_MAX=300

# SMTP settings for password reset and complaint notifications
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Google Gemini AI (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# NVIDIA NIM AI & Embeddings (https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
